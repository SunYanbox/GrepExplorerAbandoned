<Window x:Class="GrepExplorer.UI.Dialogs.UnsavedChangesWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:GrepExplorer.UI.Controls"
        Title="未保存的更改" Width="680" Height="480"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False">
    <DockPanel Margin="12">
        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,8,0,0">
            <Button x:Name="BtnSave" Content="保存到文件" Click="OnSave" Padding="14,4" Margin="0,0,8,0"/>
            <Button x:Name="BtnDiscard" Content="放弃更改" Click="OnDiscard" Padding="14,4" Margin="0,0,8,0"/>
            <Button x:Name="BtnCancel" Content="取消操作" Click="OnCancel" Padding="14,4" IsCancel="True"/>
        </StackPanel>
        <TextBlock DockPanel.Dock="Top" x:Name="MessageText" TextWrapping="Wrap" Margin="0,0,0,8"
                   Text="当前 Markdown 编辑器存在未保存的更改。"/>
        <controls:InlineDiffEditor x:Name="Diff" Visibility="Collapsed"/>
    </DockPanel>
</Window>
