<Window x:Class="GrepExplorer.UI.Dialogs.InputWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Width="380" SizeToContent="Height"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False">
    <StackPanel Margin="12">
        <TextBlock x:Name="MessageText" TextWrapping="Wrap" Margin="0,0,0,8"/>
        <TextBox x:Name="InputBox" MinHeight="28" KeyDown="OnKeyDown"/>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,8,0,0">
            <Button Content="确定" Click="OnOk" Padding="14,4" Margin="0,0,8,0" IsDefault="True"/>
            <Button Content="取消" Click="OnCancel" Padding="14,4" IsCancel="True"/>
        </StackPanel>
    </StackPanel>
</Window>
