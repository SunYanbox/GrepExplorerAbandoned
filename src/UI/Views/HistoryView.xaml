<UserControl x:Class="GrepExplorer.UI.Views.HistoryView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <DockPanel Margin="4">
        <!-- 筛选 + 工具栏 -->
        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,6">
            <TextBlock Text="范围：" VerticalAlignment="Center"/>
            <ComboBox Width="110" SelectedIndex="{Binding ScopeIndex}" Margin="0,0,12,0">
                <ComboBoxItem Content="全局"/>
                <ComboBoxItem Content="当前工作目录"/>
            </ComboBox>
            <TextBlock Text="模式：" VerticalAlignment="Center"/>
            <ComboBox Width="90" SelectedIndex="{Binding ModeFilterIndex}" Margin="0,0,12,0">
                <ComboBoxItem Content="全部"/>
                <ComboBoxItem Content="Glob"/>
                <ComboBoxItem Content="Grep"/>
            </ComboBox>
            <TextBlock Text="根目录：" VerticalAlignment="Center"/>
            <ComboBox Width="170" ItemsSource="{Binding RootOptions}" SelectedItem="{Binding RootFilter}" Margin="0,0,12,0"/>
            <TextBlock Text="组：" VerticalAlignment="Center"/>
            <ComboBox Width="140" ItemsSource="{Binding GroupOptions}" SelectedItem="{Binding GroupFilter}" Margin="0,0,12,0"/>
            <Button Content="刷新" Command="{Binding RefreshCommand}" Padding="10,2"/>
        </StackPanel>

        <!-- 清理入口（六种，均二次确认 + 预估影响条数） -->
        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,6">
            <Button Content="清理全部" Command="{Binding CleanupAllCommand}" Padding="8,2" Margin="0,0,4,0"/>
            <Button Content="清理当前项目" Command="{Binding CleanupProjectCommand}" Padding="8,2" Margin="0,0,4,0"/>
            <TextBlock Text="≥" VerticalAlignment="Center" Margin="8,0,2,0"/>
            <TextBox Width="48" Text="{Binding CleanupDaysText, UpdateSourceTrigger=PropertyChanged}" VerticalAlignment="Center"
                     ToolTip="≥ N 天：超过该天数的记录会被清理（默认 30）"/>
            <TextBlock Text="天：" VerticalAlignment="Center" Margin="2,0,4,0"/>
            <Button Content="清理全局旧记录" Command="{Binding CleanupGlobalOldCommand}" Padding="8,2" Margin="0,0,4,0"/>
            <Button Content="清理本项目旧记录" Command="{Binding CleanupProjectOldCommand}" Padding="8,2" Margin="0,0,4,0"/>
            <Button Content="删除勾选记录" Command="{Binding CleanupSelectedCommand}" Padding="8,2" Margin="0,0,4,0"/>
            <Button Content="清理重复项" Command="{Binding CleanupDuplicatesCommand}" Padding="8,2" Margin="0,0,12,0"/>
            <Button Content="导出选中记录" Command="{Binding ExportSelectedCommand}" Padding="8,2"/>
        </StackPanel>

        <!-- 统计栏 -->
        <TextBlock DockPanel.Dock="Bottom" Text="{Binding StatsText}" Opacity="0.8" Margin="0,6,0,0"/>

        <!-- 记录列表 -->
        <ListView x:Name="RecordsList" ItemsSource="{Binding Records}" SelectedItem="{Binding Selected}"
                  MouseDoubleClick="OnRecordDoubleClick">
            <ListView.View>
                <GridView>
                    <GridViewColumn Header=" " Width="30">
                        <GridViewColumn.CellTemplate>
                            <DataTemplate>
                                <CheckBox IsChecked="{Binding IsCheckedForDelete, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                            </DataTemplate>
                        </GridViewColumn.CellTemplate>
                    </GridViewColumn>
                    <GridViewColumn Header="时间" Width="130" DisplayMemberBinding="{Binding CreatedAtText}"/>
                    <GridViewColumn Header="模式" Width="60" DisplayMemberBinding="{Binding Mode}"/>
                    <GridViewColumn Header="根目录" Width="200" DisplayMemberBinding="{Binding RootPath}"/>
                    <GridViewColumn Header="组" Width="160" DisplayMemberBinding="{Binding GroupAliases}"/>
                    <GridViewColumn Header="正则/Glob" Width="200" DisplayMemberBinding="{Binding Pattern}"/>
                    <GridViewColumn Header="命中文件" Width="70" DisplayMemberBinding="{Binding HitFiles}"/>
                    <GridViewColumn Header="总命中" Width="60" DisplayMemberBinding="{Binding TotalHits}"/>
                    <GridViewColumn Header="快照大小" Width="80" DisplayMemberBinding="{Binding SnapshotSizeText}"/>
                </GridView>
            </ListView.View>
        </ListView>
    </DockPanel>
</UserControl>
