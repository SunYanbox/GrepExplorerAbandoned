<UserControl x:Class="GrepExplorer.UI.Views.MdEditorView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:GrepExplorer.UI.Controls">
    <UserControl.InputBindings>
        <KeyBinding Modifiers="Control" Key="S" Command="{Binding SaveCommand}"/>
    </UserControl.InputBindings>
    <DockPanel Margin="4">
        <!-- 工具栏：快捷插入（2.3） -->
        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,6">
            <Button Content="H1" Command="{Binding InsertH1Command}" Padding="8,2" Margin="0,0,2,0"/>
            <Button Content="H2" Command="{Binding InsertH2Command}" Padding="8,2" Margin="0,0,2,0"/>
            <Button Content="H3" Command="{Binding InsertH3Command}" Padding="8,2" Margin="0,0,8,0"/>
            <Button Content="B 加粗" Command="{Binding InsertBoldCommand}" Padding="8,2" Margin="0,0,2,0"/>
            <Button Content="I 斜体" Command="{Binding InsertItalicCommand}" Padding="8,2" Margin="0,0,8,0"/>
            <Button Content="行内代码" Command="{Binding InsertInlineCodeCommand}" Padding="8,2" Margin="0,0,2,0"/>
            <Button Content="代码块" Command="{Binding InsertCodeBlockCommand}" Padding="8,2" Margin="0,0,8,0"/>
            <Button Content="有序列表" Command="{Binding InsertOrderedListCommand}" Padding="8,2" Margin="0,0,2,0"/>
            <Button Content="无序列表" Command="{Binding InsertUnorderedListCommand}" Padding="8,2" Margin="0,0,8,0"/>
            <Button Content="引用" Command="{Binding InsertQuoteCommand}" Padding="8,2" Margin="0,0,8,0"/>
            <Button Content="链接" Command="{Binding InsertLinkCommand}" Padding="8,2" Margin="0,0,8,0"/>
            <Button Content="表格" Command="{Binding InsertTableCommand}" Padding="8,2" Margin="0,0,8,0"/>
            <Button Content="图片" Command="{Binding InsertImageCommand}" Padding="8,2" Margin="0,0,8,0"/>
            <Button Content="Ctrl+S 保存/导出 (.md)" Command="{Binding SaveCommand}" Padding="8,2"/>
            <TextBlock Text="{Binding Title}" VerticalAlignment="Center" Margin="12,0,0,0" Opacity="0.7"/>
            <TextBlock Text="● 未保存" Foreground="Orange" VerticalAlignment="Center" Margin="8,0,0,0">
                <TextBlock.Style>
                    <Style TargetType="TextBlock">
                        <Setter Property="Visibility" Value="Collapsed"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsDirty}" Value="True">
                                <Setter Property="Visibility" Value="Visible"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>
        </StackPanel>

        <controls:CodeEditor x:Name="Editor" CodeText="{Binding Text, UpdateSourceTrigger=PropertyChanged}"
                             FontSize="14" WordWrap="True"/>
    </DockPanel>
</UserControl>
