<UserControl x:Class="GrepExplorer.UI.Views.GroupsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:GrepExplorer.UI.Controls">
    <DockPanel Margin="4">
        <!-- 工具栏 -->
        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,6">
            <Button Content="新建组" Command="{Binding NewCommand}" Padding="10,2" Margin="0,0,4,0"/>
            <Button Content="保存" Command="{Binding SaveCommand}" Padding="10,2" Margin="0,0,4,0"/>
            <Button Content="复制组" Command="{Binding CopyCommand}" Padding="10,2" Margin="0,0,4,0"/>
            <Button Content="删除（确认）" Command="{Binding DeleteCommand}" Padding="10,2" Margin="0,0,12,0"/>
            <Button Content="预览（工作目录）" Command="{Binding PreviewCommand}" Padding="10,2" Margin="0,0,12,0"/>
            <Button Content="恢复内置组" Command="{Binding RestoreBuiltInsCommand}" Padding="10,2" Margin="0,0,4,0"/>
            <Button Content="导出 JSON" Command="{Binding ExportJsonCommand}" Padding="10,2" Margin="0,0,4,0"/>
            <Button Content="导入 JSON" Command="{Binding ImportJsonCommand}" Padding="10,2"/>
        </StackPanel>
        <TextBlock DockPanel.Dock="Bottom" Text="{Binding StatusMessage}" Opacity="0.8" TextWrapping="Wrap" Margin="0,6,0,0"/>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="260"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- 列表 -->
            <DockPanel Grid.Column="0" Margin="0,0,8,0">
                <TextBlock DockPanel.Dock="Top" Text="组列表（🛡 = 内置组）" FontWeight="SemiBold" Margin="0,0,0,4"/>
                <ListBox ItemsSource="{Binding Groups}" SelectedItem="{Binding Selected}">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding Display}"/>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </DockPanel>

            <!-- 编辑表单（始终可编辑：选中组即载入，新建组后直接填写） -->
            <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="别名（唯一、非空、≤32 字符）：" VerticalAlignment="Center"/>
                        <TextBox Width="240" Text="{Binding Alias, UpdateSourceTrigger=PropertyChanged}" Padding="2"
                                 VerticalContentAlignment="Center"/>
                        <TextBlock Text="备注：" Margin="12,0,3,0" VerticalAlignment="Center"/>
                        <TextBox Width="300" Text="{Binding Remark, UpdateSourceTrigger=PropertyChanged}" Padding="2"
                                 VerticalContentAlignment="Center"/>
                    </StackPanel>
                    <Grid Margin="0,8,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <controls:TagListControl Grid.Column="0" Title="Include（额外包含）"
                            Hint="语法：回车逐条添加（每行一条）；* 匹配单层、** 跨目录、? 单字符；以 ! 开头 = 反向（排除）。"
                            ListText="{Binding IncludeText}" Margin="0,0,4,0"/>
                        <controls:TagListControl Grid.Column="1" Title="Exclude"
                            Hint="语法：回车逐条添加；命中任意一条即排除该文件；以 ! 开头 = 豁免（re-include）。"
                            ListText="{Binding ExcludeText}" Margin="4,0,0,0"/>
                    </Grid>
                    <Grid Margin="0,6,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <controls:TagListControl Grid.Column="0" Title="Exclude-From（规则文件）"
                            Hint="语法：回车逐条添加「文件路径」；每个文件内每行是一条排除规则（# 开头为注释）。"
                            ListText="{Binding ExcludeFromText}" Margin="0,0,4,0"/>
                        <controls:TagListControl Grid.Column="1" Title="Exclude-Dir"
                            Hint="语法：回车逐条添加「目录名或相对路径」（如 bin、node_modules），整个目录剪除。"
                            ListText="{Binding ExcludeDirText}" Margin="4,0,0,0"/>
                    </Grid>

                    <!-- 预览 -->
                    <Border Padding="8,6" Margin="0,10,0,0" CornerRadius="4" BorderThickness="1" BorderBrush="#8888">
                        <StackPanel>
                            <TextBlock Text="预览（按当前编辑区规则，各最多 500 条 + 总数）" FontWeight="SemiBold"/>
                            <TextBlock Text="{Binding PreviewStats}" TextWrapping="Wrap" Opacity="0.8"/>
                            <TextBlock Text="将包含：" Margin="0,4,0,0"/>
                            <TextBlock Text="{Binding PreviewIncluded}" FontFamily="Consolas" FontSize="11" TextWrapping="Wrap" MaxHeight="150"/>
                            <TextBlock Text="将排除：" Margin="0,4,0,0"/>
                            <TextBlock Text="{Binding PreviewExcluded}" FontFamily="Consolas" FontSize="11" TextWrapping="Wrap" MaxHeight="150"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>
        </Grid>
    </DockPanel>
</UserControl>
