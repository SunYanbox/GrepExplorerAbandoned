<Window x:Class="GrepExplorer.UI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:GrepExplorer.UI.ViewModels"
        xmlns:views="clr-namespace:GrepExplorer.UI.Views"
        Title="Grep Explorer" Width="1280" Height="800" WindowStartupLocation="CenterScreen">
    <Window.Resources>
        <DataTemplate DataType="{x:Type vm:SearchViewModel}">
            <views:SearchView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:MdEditorViewModel}">
            <views:MdEditorView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:RegexEditorViewModel}">
            <views:RegexEditorView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:GroupsViewModel}">
            <views:GroupsView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:HistoryViewModel}">
            <views:HistoryView/>
        </DataTemplate>
        <!-- 搜索页「命令编辑器」标签页内嵌的视图（缺失时只显示 VM 类型名） -->
        <DataTemplate DataType="{x:Type vm:CommandEditorViewModel}">
            <views:CommandEditorView/>
        </DataTemplate>
    </Window.Resources>

    <DockPanel>
        <!-- 顶栏：工作目录常驻（2.9）。同一行内所有控件统一高度 + 垂直居中，保证基线对齐 -->
        <Border DockPanel.Dock="Top" Padding="10,8" BorderThickness="0,0,0,1" BorderBrush="#33888888">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="工作目录：" VerticalAlignment="Center"/>
                    <TextBox Text="{Binding WorkingDirectory, Mode=OneWay}" IsReadOnly="True" Width="420"
                             Height="28" Padding="6,0" VerticalAlignment="Center" VerticalContentAlignment="Center"
                             ToolTip="每次启动 = 进程启动目录（不恢复上次目录）"/>
                    <Button Content="切换…" Command="{Binding SwitchWorkingDirectoryCommand}"
                            MinWidth="72" Height="28" Padding="10,0" Margin="8,0,0,0" VerticalAlignment="Center"/>
                    <Button Content="转到…" Command="{Binding ManualDirectoryCommand}"
                            MinWidth="72" Height="28" Padding="10,0" Margin="4,0,0,0" VerticalAlignment="Center"
                            ToolTip="手输路径"/>
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="12,0,0,0">
                    <TextBlock Text="最近：" VerticalAlignment="Center"/>
                    <ComboBox Width="200" Height="28" VerticalAlignment="Center" VerticalContentAlignment="Center"
                              ItemsSource="{Binding RecentDirectories}"
                              SelectedItem="{Binding RecentSelected}" Margin="4,0"
                              ToolTip="选择最近使用的工作目录"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- 左侧导航 -->
        <ListBox DockPanel.Dock="Left" Width="140" VerticalAlignment="Stretch"
                 SelectedIndex="{Binding NavIndex}">
            <ListBoxItem Content="🔍 搜索" Padding="10,8"/>
            <ListBoxItem Content="📝 Markdown 编辑器" Padding="10,8"/>
            <ListBoxItem Content="🧩 正则编辑器" Padding="10,8"/>
            <ListBoxItem Content="📁 组管理" Padding="10,8"/>
            <ListBoxItem Content="🕘 历史记录" Padding="10,8"/>
        </ListBox>

        <!-- 主内容 -->
        <ContentControl Content="{Binding CurrentView}"/>
    </DockPanel>
</Window>
