<UserControl x:Class="GrepExplorer.UI.Controls.MultiLineListControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <DockPanel>
        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,2">
            <TextBlock Text="{Binding Title, RelativeSource={RelativeSource AncestorType=UserControl}}"
                       FontWeight="SemiBold" VerticalAlignment="Center"/>
            <TextBlock x:Name="CountText" Text="0 条" Margin="8,0" Opacity="0.7" VerticalAlignment="Center"/>
            <Button Content="复制全部" Click="CopyAll" Margin="4,0" Padding="8,2" MinWidth="64"/>
            <Button Content="导出" Click="ExportAll" Margin="4,0" Padding="8,2" MinWidth="48"/>
        </StackPanel>
        <TextBox x:Name="Items"
                 Text="{Binding ListText, RelativeSource={RelativeSource AncestorType=UserControl}, UpdateSourceTrigger=PropertyChanged}"
                 AcceptsReturn="True" TextWrapping="NoWrap"
                 VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"
                 FontFamily="Consolas, Cascadia Mono" FontSize="12"
                 MinHeight="56" TextChanged="OnTextChanged"/>
    </DockPanel>
</UserControl>
